%% Conceptual architecture of srag-insights-agent.
%% Export to PDF: open https://mermaid.live, paste this file, then Actions > PDF
%% (or: npx -p @mermaid-js/mermaid-cli mmdc -i docs/architecture.mmd -o docs/architecture.pdf)
flowchart LR
    user([Health professional]) --> ui["CLI / Streamlit"]
    ui -->|"generate_report(uf)"| inG{{"Input guardrail<br/>UF whitelist"}}

    subgraph agent["LangGraph — Orchestrator Agent"]
        direction TB
        orch["Orchestrator node<br/>(LLM + bound tools)"]
        check{{"Required-tools check"}}
        writer["Writer node<br/>(LLM explains metrics)"]
        outG{{"Output guardrail<br/>numbers · citations · disclaimer · PII"}}
        orch --> check --> writer --> outG
        outG -- "fail (retry ≤1)" --> writer
    end

    inG --> orch

    subgraph tools["Tools (fixed, read-only)"]
        t1["get_metrics(uf)"]
        t2["get_case_series(uf)"]
        t3["search_news(query, uf)"]
    end

    orch <-->|tool calls| t1
    orch <-->|tool calls| t2
    orch <-->|tool calls| t3

    llm[("Claude Haiku<br/>Anthropic API")]
    orch <-.->|prompts / tool decisions| llm
    writer <-.->|aggregated data + sanitized news| llm

    subgraph data["Data layer"]
        raw[("Open DATASUS<br/>SRAG CSV")] -->|"prepare: select columns,<br/>clean, drop identifiers"| pq[("Parquet")]
        pq --> duck[("DuckDB<br/>read_only")]
    end
    t1 --> duck
    t2 --> duck
    t2 --> charts["Charts<br/>matplotlib PNG"]

    t3 --> tav[("Tavily Search API")]
    tav --> san{{"News sanitizer<br/>domain allowlist · recency · injection strip"}}
    san --> t3

    outG --> render["Report renderer<br/>Jinja2 HTML → PDF (Playwright)"]
    charts --> render
    render --> out[/"report.html · report.pdf"/]

    audit[("Audit log<br/>audit.jsonl + manifest.json")]
    agent -.->|every node, tool, LLM call, guardrail decision| audit
    render -.-> audit
