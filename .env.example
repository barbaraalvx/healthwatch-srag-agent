# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Secrets ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# --- LLM ---
LLM_MODEL=claude-haiku-5-5
# Haiku 5.5 does not accept a temperature. Effort: low, medium or high (lower is cheaper).
LLM_EFFORT=low
# Output cap per call; it includes the model's reasoning tokens (2000 cut a draft short in a real run).
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Prices per million tokens (USD), used to estimate run cost in the audit log. Check the provider's pricing page.
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# --- Agent guardrails ---
AGENT_MAX_ITERATIONS=8
RUN_TIMEOUT_SECONDS=180
MAX_COST_USD_PER_RUN=0.10

# --- News ---
# Results fetched per search (one credit) and how many relevant ones are sent to the LLM.
NEWS_MAX_RESULTS=10
NEWS_MAX_ITEMS=5
# Searches per run (1 Tavily credit each): the first one plus refinements.
NEWS_MAX_SEARCHES=2
NEWS_DAYS=30
NEWS_TIMEOUT_SECONDS=20

# --- Metrics ---
METRIC_WINDOW_DAYS=30
REPORT_LAG_DAYS=7
MIN_DENOMINATOR=30

# --- Paths (relative to project root) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_PATH=data/processed/srag.parquet
REPORTS_DIR=reports

# --- Logging ---
LOG_LEVEL=INFO
